/**
 * Wand functions
 */

// ===================
//      Process
// ===================

process Wand_RechargeTime {
    line current_wand = item.setDurability(default.mainHandItem, 0, durabilityType="Set Remaining Percentage") as item;
    line recharge_time = item.getTag(default.mainHandItem, "recharge.time") as num;
    default.replaceItems(default.mainHandItem, current_wand);
    while (recharge_time < 100) {
        wait;
        line recharge_time += 100/recharge_time as num;
        line new_wand = item.setDurability(current_wand, recharge_time, durabilityType="Set Remaining Percentage") as item;
        default.replaceItems(current_wand, new_wand);
        line current_wand = new_wand;
    }
}

process Wand_CastDelay {
    line base_cast_delay = item.getTag(default.mainHandItem, "base.cast.delay") as num;
    default.setItemCooldown(default.mainHandItem, line base_cast_delay + local cast_delay as num);

}

// ===================
//      Function
// ===================

function Wand_UpdateDeck(item_input:item, deck:list[str]): item {
    line deck = list.flatten(line deck);
    line text = call Wand_SetLore(line deck) as list[txt];
    line deck_str = var.toJSON(line deck) as str;
    line item_output = item.setTag(line item_input,"wand_deck",line deck_str);
    return item_output.setLore(text); 
}

function Wand_SetLore(deck:list[str]): list[txt]{
    line output = [] as list[txt];
    line items = call Wand_GetDeckItems(line deck) as list[item];
    line text = txt.setToStyledText("", inheritStyles="True");
    line slot = 1;
    for (line _item of items) {
        line model = _item.getModel();
        line model.remove(model, "minecraft:", regEx="Disable");
        line model.setToString("<sprite:items:item/", model, ">", merging="No spaces");
        // line text.parseExpression(model); // C'est cassé
        line text.setToStyledText(text, model);
        line slot_m7 = slot.remainder(7, mode="Modulo");
        if (slot_m7 == 0) {
            output.append(text);
            line text = s"";
        }
        slot += 1;
    }
    if !(str.matches(text as str, "")) {
        output.append(text);
    }
    return output;
}


function Wand_GetDeckItems(deck:list[str]): list[item]{
    line items = [] as list[item];
    for (line id of deck){
        items.append(dict.get(global spells_dict,line id));
    }
    return items;
}


function Wand_CheckEndOfSpells{
    if (list.sizeEquals(global "%default_deck", global "%default_deck_index")) {
        var.purgeMatching("%default_deck_index", matchRequirement="Full word(s) in name");
        start Wand_RechargeTime();
        endthread;
    }
}

function Wand_Cast {
    line cooldown_left = item.getDurability(default.mainHandItem);
    if (cooldown_left != 100) {
        return;
    } 
    call Wand_CheckEndOfSpells();
    global "%default_deck_index" += 1;
    start "Spell_%index(%default_deck,%var(%default_deck_index))";
    call "Spell_%index(%default_deck,%var(%default_deck_index))";
    call Wand_CheckEndOfSpells();
}

function Wand_GetDeckItem(deck?: list[str]): list {
    line items = [];
    for (line id of deck) {
        line temp_item = dict.get(global spells_dict, line id);
        items.append(temp_item);
    }
    return items;
}

