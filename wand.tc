/**
 * Wand functions
 */

// ===================
//      Process
// ===================

process Wand_RechargeTime {
    line current_wand = item.setDurability(default.mainHandItem, 0, durabilityType="Set Remaining Percentage") as item;
    line recharge_time = item.getTag(default.mainHandItem, "recharge.time") as num;
    default.replaceItems(default.mainHandItem, current_wand);
    while (recharge_time < 100) {
        wait;
        line recharge_time += 100/recharge_time as num;
        line new_wand = item.setDurability(current_wand, recharge_time, durabilityType="Set Remaining Percentage") as item;
        default.replaceItems(current_wand, new_wand);
        line current_wand = new_wand;
    }
}

process Wand_CastDelay {
    line base_cast_delay = item.getTag(default.mainHandItem, "base.cast.delay") as num;
    default.setItemCooldown(default.mainHandItem, line base_cast_delay + local cast_delay as num);

}

// ===================
//      Function
// ===================

function Wand_UpdatePlayerDeck(item_input:item){
    var.purgeMatching("%default_deck_index","%default_deck");
    line deck = item.getTag(item_input,"wand_deck") as str;
    global "%default_deck" = var.fromJSON(deck);
}

