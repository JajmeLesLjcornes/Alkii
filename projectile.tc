


function Projectile_Shoot(
    origin:loc,
    iteration?:num = 1,
    distance_per_iteration?:num = 1,
    tick_per_iteration?:num = 1,
    particle?:par,
    spread?:num = 0,
    vector_list?:list[str]): str, loc {
        line origin = Vector_SpreadRNG(origin, spread);
        repeat (iteration) {
            line target_uuid, line hit_loc = Projectile_GetTarget_Raycast(origin, distance_per_iteration);
            allPlayers.displayParticleLine(particle, origin, hit_loc);
            if (target_uuid != "") {
                return target_uuid, hit_loc;
            }
            if (game.blockEquals(hit_loc)) {
                return target_uuid, hit_loc;
            }

            line origin = line hit_loc;
            for (line vector_str of vector_list) {
                line vector_modifier =  0;
                if (vector_str.contains("=")) {
                    line vector_str_split = vector_str.split("=", stripSpaces="Enable");
                    line vector_str = "%index(vector_str_split,1)";
                    line vector_modifier = n"%index(vector_str_split,2)";  
                }
                line origin = call "Vector_%var(vector_str)"(origin, vector_modifier);
            }
            wait(tick_per_iteration);
        }
}

function Projectile_GetTarget_Raycast(origin:loc, distance_per_iteration:num): str, loc {

    line hitloc1 = Projectile_SelectionEntity(origin, distance_per_iteration);
    line _entity = game.selectionTargetUUIDs as str;
    line hitloc2 = Projectile_SelectionPlayer(origin, distance_per_iteration);
    line _player = game.selectionTargetUUIDs as str;
    select reset;
    print(hitloc1, hitloc2);

    if (hitloc1 != hitloc2) {
        line vec1 = vec.between(origin, hitloc1);
        line vec2 = vec.between(origin, hitloc2);

        line vec1length = vec1.len();
        line vec2length = vec2.len();
        if (vec2length > vec1length) {
            return _entity, hitloc1;
        }
        else {
            return _player, hitloc2;
        }
    }
    else {
        return "", hitloc1;
    }
}

function Projectile_SelectionEntity(origin:loc, distance:num, block_collision?:str="Solid blocks"): loc {
    select allEntities();
    filter byRaycast(line hit_loc, origin, distance, blockCollision=block_collision);
    // Voir pour changer si update ici
    return line hit_loc as loc; // Return 0 pour aucune raison
}


function Projectile_SelectionPlayer(origin:loc, distance:num, block_collision?:str="Solid blocks"): loc {
    select !playersByCondition(player.nameEquals(default.name as str));
    filter byRaycast(line hit_loc, origin, distance, blockCollision=block_collision);
    // Voir pour changer si update ici
    return line hit_loc as loc; // Return 0 pour aucune raison
}