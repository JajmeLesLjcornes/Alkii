// Spells :

// ===================
//      Process
// ===================

process Spell_SparkBolt {
    line can_cast = Player_Mana_Use(3);
    if (can_cast < 0) {
        call Wand_Cast;
        return;
    }
    line vector_list = [
        "gravity=0.04",
    ];
    call SpellModifier_add(vector_list);
    local cast_delay = 5;
    start Wand_CastDelay(localVariables="Share", targetMode="With current targets");

}

process Spell_SmallTeleportBolt {
    
}

