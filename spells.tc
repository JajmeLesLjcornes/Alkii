/**
 * Spells list, file that contains all the spells of Alkii
 */


function SpellModifier_add_remove(vector_list:list[str]): list[str] {
    line vector_list.appendList(local spell_modifier_add);
    for (line vector_str of vector_list) {
        for (line remove_str of spell_modifier_remove) {
            if (str.startsWith(line vector_str, line remove_str)) {
                line vector_list.removeValue(vector_str);
            }
        }
    }
    return vector_list;
}



// Spells :

// ===================
//      Process
// ===================

process Spell_SparkBolt {
    line can_cast = Player_Mana_Use(3);
    if (can_cast < 0) {
        call Wand_Cast;
        return;
    }
    line vector_list = [
        "gravity=0.04",
    ] as list[str];
    call SpellModifier_add_remove(vector_list);
    local cast_delay = 5;
    start Wand_CastDelay(localVariables="Share", targetMode="With current targets");

}

process Spell_SmallTeleportBolt {
    line can_cast = Player_Mana_Use(15);
    if (can_cast < 0) {
        call Wand_Cast;
        return;
    }
    line vector_list = [] as list[str];
    call SpellModifier_add_remove(vector_list);
    start Wand_CastDelay(localVariables="Share", targetMode="With current targets");
    line hit_target_uuid, line hit_target_loc = Projectile_Shoot(
        default.eyeLocation,
        1,
        10,
        0,
        par("copper_fire_flame", amount=1, spreadHoriz=0, spreadVert=0),
        0,
        vector_list
    );
    selected.teleport(hit_target_loc);
}

// ===================
//      Function
// ===================

function Spell_EmptySlot {
    call Wand_Cast;
}

function Spell_DoubleCast {
    call Wand_Cast;
    call Wand_Cast;
}

function Spell_NoGravity {
    line can_cast = Player_Mana_Use(1);
    if (can_cast < 0) {
        call Wand_Cast();
        return;
    }
    local spell_modifier_remove.append("gravity");
    call Wand_Cast();
}