gameevent startup {
     game_setup_vars();
     start game_loop1t;
}

function game_setup_vars {
line spells_id = [
    "Spark Bolt",
    "Double Cast",
    "No Gravity",
    "Small Teleport Bolt",
    "Empty slot"
];

}

