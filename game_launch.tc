gameevent startup {
    global game_loading = 1;
    game_setup_vars();
    start Game_Loop1t;
    global game_loading = 0;

}

function game_setup_vars {
    line spells_id = [
        "SparkBolt",
        "DoubleCast",
        "NoGravity",
        "SmallTeleportBolt",
        "EmptySlot"
    ];

    line spells_item:list[item] = [
        litem("spell_items", "spark_bolt"),
        litem("spell_items", "double_cast"),
        litem("spell_items", "no_gravity"),
        litem("spell_items", "small_teleport_bolt"),
        litem("spell_items", "empty_slot")
    ];
    line temp_spells_dict:dict[item] = dict.create(line spells_id, line spells_item);
    global spells_dict:dict[item];
    for (line spell_id,line spell_item of line temp_spells_dict)
        {
            line spell_item = item.setTag(line spell_item,"spell_id",line spell_id);
            line spell_item = item.setMaxStackSize(line spell_item,1);
            dict.set(global spells_dict, line spell_id, line spell_item);
        }
}   

