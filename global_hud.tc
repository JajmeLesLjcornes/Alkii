



function Tab_HUD() {
    line tab_names = "";
    for (line player_name of game.plotPlayerNames) {
        line tab_names = tab_names.setToString(tab_names, player_name, merging="Add spaces");
    }
    allPlayers.setTabListInfo(
        s"<strikethrough><gradient:#5e4fa2:#f79459:red><space:50></gradient>",
        s"<space><#994173>Alkii<space>",
        s"<strikethrough><gradient:red:#f79459:#5e4fa2><space:50></gradient>",
        s"<newline>",
        s"<newline><#cbb7ff>",
        tab_names as txt,
        s"<newline>",
    );
}