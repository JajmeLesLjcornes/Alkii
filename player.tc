

// Process 

process Player_Loop1t() {
    while (player.isInGameMode(gamemode="Adventure")) {
        call Player_ShowCurrentMana();
        call Player_ShowCurrentHealth();
        call Player_HUD();
        // Fin de loop
        wait(1, unit="Ticks");
    }
}

process Player_Loop_SpecSoul() {
    while (player.isInGameMode(gamemode="Spectator")) {
        select eventTarget(target="Default");
        select inverse;
        selected.displayParticleEffect(par("soul"), default.eyeLocation);

        // Fin de loop
        wait(1, unit="Seconds");
    }
}

//

function Player_ShowCurrentMana() {
    default.setExperience(n"%math(100 * %var(%default_mana) / %var(%default_mana_max))", unit="Level Percentage");
    default.setExperience(n"%var(%default_mana)", unit="Level");
}

function Player_ShowCurrentHealth() {
    
}

function Player_HUD() {
    default.sendActionBar(
        s"<#cc88b9>",
        n"%var(%default_hp_max)",
        s"<#634566>/<#cc88b9>",
        n"%var(%default_hp)",
        s"❤",
        inheritStyles="True", merging="No spaces"
    );
}




function Player_Leave() {
    allPlayers.sendMessage(s"<#996363>-", default.name, merging="Add spaces");
}

function Player_Join() {
    while !(var.exists(spells_dict)) {
        default.sendTitle(s"Loading", s"", 5, 0, 0);
        wait;
    }
    

    default.setChatStyle(s"<italic><#78cca6>");
    default.setWorldBorder(loc(150.5, 0.5, 150.5), 150);
    default.setAllowHandCrafting(allow="Disable");
    default.setInstantRespawn();

    call Player_SetSpecMode();

    allPlayers.sendMessage(s"<#a9c8cc>+", default.name, merging="Add spaces");
}

function Player_SetPlayMode() {
    default.clearInventory(clearCraftingAndCursor="True", clearMode="Entire inventory");
    default.setToAdventureMode();

    // Set vars
    global "%default_mana" = 100;
    global "%default_mana_max" = 100;

    global "%default_hp" = 100;    
    global "%default_hp_max" = 100;

    start Player_Loop1t;

    // Tempo
    default.setHotbarItems(
        call Wand_UpdateDeck(litem("wand", "wand"), ["SmallTeleportBolt"]),
        call Wand_UpdateDeck(litem("wand", "wand"), ["SparkBolt","SparkBolt","SparkBolt","SparkBolt"])
        );
    call Player_Wand_UpdateDeck(default.mainHandItem);
}

function Player_Death() {

    call Player_SetSpecMode();
    endthread;

}

function Player_SetSpecMode() {
    default.setToSpectatorMode();
    default.clearInventory(clearCraftingAndCursor="True", clearMode="Entire inventory");
    default.teleport(loc(150, 150, 150));
    default.setBossBar(s"<#789499>Open your inventory to start the adventure", color="White");
    default.setInventoryItems(
        item("air"),item("air"),item("air"),item("air"),item("air"),item("air"),item("air"),item("air"),item("air"),
        item("air"),item("air"),litem("menu_items","eternal_unlock_button"),item("air"),litem("menu_items","play_button"),item("air"),litem("menu_items","settings_button"));
    start Player_Loop_SpecSoul();
    default.setSpectatorCollision();

}



//////////////////////////
// Player Wand Function //
//////////////////////////

function Player_Wand_UpdateDeck(item_input:item){
    var.purgeMatching("%default_deck_index","%default_deck");
    line deck = item.getTag(item_input,"wand_deck") as str;
    global "%default_deck" = var.fromJSON(deck) as list[str];
}

//////////////////////////
// Player Menu Function //
//////////////////////////

////////////////
// WandEditor //
////////////////

function Player_ShowInv_WandEditor {
    if (item.hasTag(default.mainHandItem, "item_type", "Wand")) {
        call Player_Wand_UpdateDeck(default.mainHandItem);
        line items = Wand_GetDeckItem(global "%default_deck") as list[item];
        line items_len = list.len(items);
        default.showInventoryMenu(
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_1"),
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_1"));                
        default.expandInventoryMenu(
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_1"),
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_2"),litem("menu_items", "wandeditor_1"),
            litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1"),litem("menu_items", "wandeditor_1")); 
        line slot = 11;
        for (line temp_item of items) {
            if (item.hasTag(temp_item, "spell_id", "EmptySlot")) {
                default.setInventoryMenuItem(slot);
            }
            else {
                default.setInventoryMenuItem(slot, temp_item);
            }
            line slot += 1;
            line slot_m9 = slot.remainder(9, mode="Modulo");
            if (slot_m9 == 0) {
                slot += 2;
            }
        }
        default.setInventoryMenuName(s"WandEditor");

    }
}

function Player_ClickMenuSlot_WandEditor{
    event.uncancel();
    if(item.hasTag(event.clickedSlotItem,"menu_tag","cancel")){
        event.cancel();
    }
}

function Player_CloseInv_WandEditor{
    line new_deck:list[str];
    for(line i of default.inventoryMenuItems){
        if(!var.isEmpty(i)){
            if(item.hasTag(i,"spell_id")){
                line spell_id = item.getTag(i,"spell_id");
                list.append(line new_deck,spell_id);
            }
        }
        else{
            list.append(line new_deck,"EmptySlot");
        }
    }
    if (var.exists(new_deck)) {
        line wand = Wand_UpdateDeck(default.mainHandItem,new_deck);
        default.replaceItems(default.mainHandItem,wand);
        call Player_Wand_UpdateDeck(wand);
    }
}
